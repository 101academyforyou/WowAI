{
  "expo": {
    "name": "YourWowAI",
    "slug": "yourwowai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourwowai.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "zh_TW"
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#05070d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yourwowai.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "YourWowAI",
      "shortName": "YourWowAI",
      "lang": "en",
      "description": "YourWowAI: share the tools you build with AI. Every post shows the real thing: a screenshot or a YouTube demo.",
      "themeColor": "#05070d",
      "backgroundColor": "#05070d"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "YourWowAI 需要存取你的相簿，才能讓你選擇要分享的截圖。",
          "cameraPermission": "YourWowAI 需要使用相機，才能讓你拍攝要分享的作品照片。",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#05070d"
        }
      ],
      "expo-notifications",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "scheme": "yourwowai",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://yourwowai.onepointzeroone.org"
    },
    "backgroundColor": "#05070d",
    "locales": {
      "en": "./locales/en.json",
      "zh-Hant": "./locales/zh-Hant.json"
    }
  }
}
